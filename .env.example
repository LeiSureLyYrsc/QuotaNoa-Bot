DRIVER=~fastapi+~httpx+~websockets+~aiohttp
SUPERUSERS=["12345678"]
COMMAND_START=["/"]

# OneBot V11（反向 WS：NoneBot 主动连接协议端）
ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]
ONEBOT_ACCESS_TOKEN=your_onebot_token

# Telegram（可与 OneBot 同时启用）
telegram_bots=[{"token": "123456:ABC-DEF"}]
# TELEGRAM_PROXY=http://127.0.0.1:7890

# QuotaNoa 插件
# 业务配置（CPA 实例、火山凭据、渲染主题、别名文件路径）
# 全部放在 data/quotanoa_config.json，首次启动自动生成。
# .env 里与此插件相关的是两个配置文件路径（均可选覆盖）：
# QUOTANOA_CONFIG_FILE=data/quotanoa_config.json
# QUOTANOA_CLIENT_CONFIG_FILE=data/quotanoa_client.json
#
# 远程客户端（Server 模式）：配置在独立文件 data/quotanoa_client.json 的 server 段与顶层 clients。
# 服务器模式默认关闭（server.enabled=false），可用 /quotanoa client server on 热开启。
