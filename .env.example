DRIVER=~fastapi+~httpx+~websockets+~aiohttp
SUPERUSERS=["12345678"]
COMMAND_START=["/"]

# OneBot V11（反向 WS：NoneBot 主动连接协议端）
ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]
ONEBOT_ACCESS_TOKEN=your_onebot_token

# Telegram（可与 OneBot 同时启用）
telegram_bots=[{"token": "123456:ABC-DEF"}]
# TELEGRAM_PROXY=http://127.0.0.1:7890

# QuotaNoa 插件
# 业务配置（CPA 实例、火山凭据、渲染主题、别名文件路径）
# 全部放在 data/quotanoa_config.json，首次启动自动生成。
# .env 里唯一与此插件相关的是配置文件路径（可选覆盖）：
# QUOTANOA_CONFIG_FILE=data/quotanoa_config.json

# 远程客户端（Server 模式）——独立 FastAPI 服务端，不与 NoneBot 共享实例。
# 默认关闭；启用后 Go 客户端可主动连入，由 Bot 远程查询/受控刷新。
# QUOTANOA_CLIENT_SERVER_ENABLED=false
# QUOTANOA_CLIENT_SERVER_NAME=Server
# QUOTANOA_CLIENT_HOST=127.0.0.1
# QUOTANOA_CLIENT_PORT=8320
# QUOTANOA_CLIENT_REQUEST_TIMEOUT=40
# QUOTANOA_CLIENT_WS_MAX_SIZE=1048576
# QUOTANOA_CLIENT_MAX_ACCOUNTS=200
# 客户端注册表路径；仅在 /quotanoa client add 时生成，不随启动自动创建。
# QUOTANOA_CLIENT_FILE=data/quotanoa_client.json
